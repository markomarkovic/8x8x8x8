rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to GIFs
    match /gifs/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
