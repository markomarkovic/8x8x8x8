rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    // Checks if a document exists in the admins collection with the user's UID
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection - single source of truth for admin users
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false; // Only manually editable in Firebase Console
    }

    // Gallery collection - read by anyone, write only by Cloud Functions
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Anyone can read approved submissions
      // Users can read their own submissions
      // Admins can read all submissions
      allow read: if resource.data.status == 'approved'
                  || (request.auth != null && request.auth.uid == resource.data.userId)
                  || isAdmin();

      // Authenticated users can create submissions
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Only Cloud Functions can update (approval/rejection)
      allow update: if false;

      // Users cannot delete submissions
      allow delete: if false;
    }
  }
}
